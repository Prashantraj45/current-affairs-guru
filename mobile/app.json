{
  "expo": {
    "name": "Current Affairs Guru",
    "slug": "current-affairs-guru",
    "version": "1.0.0",
    "scheme": "cag",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": { "image": "./assets/splash-icon.png", "resizeMode": "contain", "backgroundColor": "#1a1a2e" },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cag.currentaffairsguru",
      "infoPlist": { "NSUserNotificationUsageDescription": "We send daily current affairs updates." }
    },
    "android": {
      "package": "com.civil.currentaffairsguru",
      "adaptiveIcon": { "foregroundImage": "./assets/android-icon-foreground.png", "backgroundImage": "./assets/android-icon-background.png" },
      "permissions": ["RECEIVE_BOOT_COMPLETED", "VIBRATE"]
    },
    "plugins": [
      ["expo-notifications", { "icon": "./assets/icon.png", "color": "#6366f1" }]
    ],
    "extra": { "eas": { "projectId": "PLACEHOLDER" } }
  }
}
